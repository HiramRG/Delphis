<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: what goes into cloud backups and device-to-device moves. Settings and presets do (the
     RetroAchievements key in them is encrypted with a key that stays on the device, so a restored copy is unreadable).
     Logs, achievement progress, autosave copies and caches don't. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="last-crash.txt" />
        <exclude domain="file" path="events.txt" />
        <exclude domain="file" path="exits.txt" />
        <exclude domain="file" path="ra-progress/" />
        <exclude domain="file" path="ra-badges/" />
        <exclude domain="file" path="autosave-backups/" />
        <exclude domain="file" path="covers/" />
        <exclude domain="file" path="covers-hq/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="last-crash.txt" />
        <exclude domain="file" path="events.txt" />
        <exclude domain="file" path="exits.txt" />
        <exclude domain="file" path="ra-progress/" />
        <exclude domain="file" path="ra-badges/" />
        <exclude domain="file" path="autosave-backups/" />
        <exclude domain="file" path="covers/" />
        <exclude domain="file" path="covers-hq/" />
    </device-transfer>
</data-extraction-rules>
