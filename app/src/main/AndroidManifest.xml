<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Box art downloads from GameTDB. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Settings → Rumble → "Try it": buzzing a motor through Android needs this. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Keeps the processor awake for a few seconds while the game is saved as the screen turns off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Wi-Fi icon in Home's bar (connected or not, signal bars). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets Delphis fully close Dolphin so a restarted game picks up new controls. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- In-app updates: install new versions downloaded from the GitHub release. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Lets us check whether Dolphin is installed (package visibility, Android 11+). -->
    <queries>
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.dolphinemu.dolphinemu.debug" />
        <package android:name="org.dolphinemu.dolphinemu.benchmark" />
        <!-- The home app, which shows Recent apps: the helper only looks there to close Dolphin's card. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".platform.CompanionApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/Theme.Delphis">

        <!--
          Targeting Android 16 (SDK 36), two of its new rules are kept off so Delphis behaves exactly as before:
          - enableOnBackInvokedCallback="false" (above): Back still reaches Delphis as a key / onBackPressed, which its
            screens and the controller's B rely on (Compose BackHandler works either way).
          - this property: on tablets (smallest width 600 dp and up) Android 16 would ignore the landscape lock;
            Delphis' screens are made for landscape, so it stays locked on one-screen devices.
          Neither changes anything on the Thor (Android 13): Android only applies a target's rules on that version and up.
        -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Frontends that take a launch command (like RetroHrai!) start games here; no screen of its own. -->
        <activity
            android:name=".ui.LaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Short, stable name for frontends' launch commands: io.github.hiramrg.delphis/.Play -->
        <activity-alias
            android:name=".Play"
            android:exported="true"
            android:targetActivity=".ui.LaunchActivity" />

        <!-- Always-on controls view for the bottom screen; its own task so it can live on another display. -->
        <activity
            android:name=".ui.NowPlayingActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:taskAffinity="io.github.hiramrg.delphis.nowplaying"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation" />
        <!-- One screen (phones, tablets): the same controls view, as a menu over the game. -->
        <activity
            android:name=".ui.InGameMenuActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:taskAffinity="io.github.hiramrg.delphis.ingame"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Delphis.Panel"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation" />
        <activity
            android:name=".ui.MenuCompanionActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:taskAffinity="io.github.hiramrg.delphis.menu"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation" />
        <activity
            android:name=".platform.CoverActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:taskAffinity="io.github.hiramrg.delphis.cover"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <receiver android:name=".platform.InstallReceiver" android:exported="false" />
        <!-- Hands the downloaded update to Android's own installer when Android blocks Delphis updating itself. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
        <!-- Opens Delphis again once it has updated itself ("Restart & update"). -->
        <receiver android:name=".platform.UpdatedReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Presses Dolphin's "Exit Emulation" so games close cleanly (see res/xml/dolphin_exit_service.xml). -->
        <service
            android:name=".platform.ExitWatchService"
            android:exported="false"
            android:stopWithTask="false" />
        <service
            android:name=".platform.DolphinExitService"
            android:exported="true"
            android:label="@string/exit_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/dolphin_exit_service" />
        </service>
    </application>
</manifest>
